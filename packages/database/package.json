{
  "name": "database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json --watch",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check-types": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
