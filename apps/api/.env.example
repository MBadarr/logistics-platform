PORT=3002
# Neon pooled Postgres connection, including sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-PROJECT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Optional alias used by existing deployments.
DATABASE_URL_POOLED=
NEON_AUTH_BASE_URL=https://ep-PROJECT.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
# Optional: defaults to NEON_AUTH_BASE_URL + /.well-known/jwks.json.
NEON_AUTH_JWKS_URL=
# Optional: defaults to the origin of NEON_AUTH_BASE_URL.
NEON_AUTH_AUDIENCE=
AWS_ENDPOINT_URL_S3=https://br-BRANCH.storage.c-7.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# Must match an existing private bucket on the same Neon branch.
S3_BUCKET=logistics
# Optional Nest Observe telemetry.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
